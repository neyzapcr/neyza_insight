<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF8FF">

    <!-- Background curve biru -->
    <View
        android:id="@+id/bgBlue"
        android:layout_width="489dp"
        android:layout_height="378dp"
        android:background="@drawable/bg_profile_curve"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="23dp"
        android:background="@color/scholar_blue"
        android:title="Profile"
        android:titleTextColor="@color/white"
        app:titleCentered="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Profile Image -->
    <ImageView
        android:id="@+id/imgProfile"
        android:layout_width="166dp"
        android:layout_height="174dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_profile_rounded"
        android:clipToOutline="true"
        android:elevation="10dp"
        android:padding="3dp"
        android:scaleType="centerCrop"
        android:src="@drawable/neyza_profile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Name -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="24dp"
        android:text="Neyza Shafalika"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:fontFamily="@font/urbanist_bold"
        app:layout_constraintTop_toTopOf="@id/imgProfile"
        app:layout_constraintStart_toEndOf="@id/imgProfile"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- NIM -->
    <TextView
        android:id="@+id/tvNim"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="24dp"
        android:text="2457301113"
        android:textColor="@color/scholar_light_blue_text_2"
        android:textSize="16sp"
        android:fontFamily="@font/urbanist_medium"
        app:layout_constraintTop_toBottomOf="@id/tvName"
        app:layout_constraintStart_toEndOf="@id/imgProfile"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campus -->
    <TextView
        android:id="@+id/tvCampus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:text="Politeknik Caltex Riau"
        android:textColor="@color/scholar_light_blue_text_2"
        android:textSize="15sp"
        android:fontFamily="@font/urbanist_medium"
        app:layout_constraintTop_toBottomOf="@id/tvNim"
        app:layout_constraintStart_toEndOf="@id/imgProfile"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Major -->
    <TextView
        android:id="@+id/tvMajor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:text="Sistem Informasi"
        android:textColor="@color/scholar_light_blue_text_2"
        android:textSize="15sp"
        android:fontFamily="@font/urbanist_medium"
        app:layout_constraintTop_toBottomOf="@id/tvCampus"
        app:layout_constraintStart_toEndOf="@id/imgProfile"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- About Me Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAboutMe"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="14dp"
        app:layout_constraintTop_toBottomOf="@id/imgProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/tvAboutMe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="About Me"
                android:textColor="@color/scholar_blue"
                android:textSize="22sp"
                android:fontFamily="@font/urbanist_bold"/>

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:background="@color/scholar_blue"/>

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mahasiswa Sistem Informasi yang aktif dalam kegiatan akademik dan kepanitiaan acara, dengan fokus pada pengembangan aplikasi, analisis sistem, serta kemampuan mengelola dan mengoordinasikan kegiatan secara terstruktur."
                android:textStyle="italic"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="@font/urbanist_medium"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_feature_item"
                    android:gravity="center"
                    android:text="Buku/Novel"
                    android:textColor="@color/scholar_blue"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_feature_item"
                    android:gravity="center"
                    android:text="Musik"
                    android:textColor="@color/scholar_blue"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_feature_item"
                    android:gravity="center"
                    android:text="Tidur"
                    android:textColor="@color/scholar_blue"
                    android:textSize="14sp"/>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Contact Menu -->
    <LinearLayout
        android:id="@+id/contactMenu"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/cardAboutMe"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnGithub"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_circle_icon"
            android:padding="8dp"
            android:src="@drawable/ic_github"/>

        <ImageView
            android:id="@+id/btnInstagram"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_circle_icon"
            android:padding="8dp"
            android:src="@drawable/ic_instagram"/>

        <ImageView
            android:id="@+id/btnLinkedin"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_circle_icon"
            android:padding="8dp"
            android:src="@drawable/ic_linkedin"/>

        <ImageView
            android:id="@+id/btnWhatsapp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_circle_icon"
            android:padding="8dp"
            android:src="@drawable/ic_whatsapp"/>

        <ImageView
            android:id="@+id/btnEmail"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_circle_icon"
            android:padding="8dp"
            android:src="@drawable/ic_email"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
