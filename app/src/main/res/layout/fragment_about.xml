<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aboutContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scholar_blue"
    android:padding="24dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:background="@color/scholar_blue"
        android:title="About"
        android:titleTextColor="@color/white"
        app:titleCentered="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvAboutTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/urbanist_bold"
        android:text="Tentang Sistem Kependudukan"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvAboutSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/urbanist_medium"
        android:text="Platform digital untuk pengelolaan data warga yang lebih efisien dan transparan"
        android:textColor="@color/scholar_light_blue_text_2"
        android:textSize="14sp"
        android:gravity="center"
        android:textStyle="italic"
        app:layout_constraintTop_toBottomOf="@id/tvAboutTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/valueContainer"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/tvAboutSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/valueFast"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_feature_item"
            android:fontFamily="@font/urbanist_bold"
            android:gravity="center"
            android:text="Cepat"
            android:textColor="@color/scholar_blue"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/valueAccurate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_feature_item"
            android:fontFamily="@font/urbanist_bold"
            android:gravity="center"
            android:text="Akurat"
            android:textColor="@color/scholar_blue"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/valueTransparent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_feature_item"
            android:fontFamily="@font/urbanist_bold"
            android:gravity="center"
            android:text="Transparan"
            android:textColor="@color/scholar_blue"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="26dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/valueContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist_medium"
            android:lineSpacingExtra="4dp"
            android:padding="18dp"
            android:text="Sistem Kependudukan merupakan solusi digital untuk mengelola data warga secara cepat, akurat, dan efisien.Aplikasi ini membantu pelayanan administrasi desa menjadi lebih tertata, transparan, dan mudah digunakan."
            android:textColor="@color/text_dark"
            android:textSize="13sp" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvFeatureTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/urbanist_bold"
        android:text="Fitur Utama"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/cardDescription"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/featureRowOne"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/tvFeatureTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/feature1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_feature_item"
            android:fontFamily="@font/urbanist_semibold"
            android:gravity="center"
            android:text="👥 Data Warga"
            android:textColor="@color/text_dark"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/feature2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_feature_item"
            android:fontFamily="@font/urbanist_semibold"
            android:gravity="center"
            android:text="🏠 Data Keluarga"
            android:textColor="@color/text_dark"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/featureRowTwo"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/featureRowOne"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/feature3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_feature_item"
            android:fontFamily="@font/urbanist_semibold"
            android:gravity="center"
            android:text="👶 Kelahiran"
            android:textColor="@color/text_dark"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/feature4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_feature_item"
            android:fontFamily="@font/urbanist_semibold"
            android:gravity="center"
            android:text="✝ Kematian"
            android:textColor="@color/text_dark"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/feature5"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_feature_item"
        android:fontFamily="@font/urbanist_semibold"
        android:gravity="center"
        android:text="🔁 Data Perpindahan"
        android:textColor="@color/text_dark"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/featureRowTwo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>