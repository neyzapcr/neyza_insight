<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NeyzaInsight" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.NeyzaInsight" parent="Base.Theme.NeyzaInsight" />

    <!-- Card dengan sudut atas melengkung (untuk header search di DataWarga) -->
    <style name="TopRoundedCard" parent="">
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="AllRoundedCard" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Theme overlay to make the M3 bottom navigation active indicator capsule transparent -->
    <style name="Theme.NeyzaInsight.BottomNav">
        <item name="colorContainer">@android:color/transparent</item>
    </style>
</resources>